APP_NAME=HalenMiaga
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password hashing: bcrypt (sha256 kept for legacy hash upgrade on login)
HASH_DRIVER=bcrypt

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bag_biz
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Checkout (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Must match the URL users use in the browser (for Stripe redirects)
# LARAVEL_APP_URL=http://localhost:8080

# Admin username (must match users.username)
BAG_ADMIN_USER=admin

# Personalized product recommendations (home, product list, product detail)
BAG_RECOMMENDATION_LIMIT=8

# Storefront AI chat (Gemini; Groq optional on free tier) + help desk tickets
# AI_CHAT_TIER=free uses Groq + Gemini with failover; paid uses Gemini only.
AI_CHAT_TIER=free
AI_CHAT_PRIMARY_WHEN_FREE=groq
AI_CHAT_FALLBACK_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_CHAT_THROTTLE_GUEST_PER_MINUTE=20
AI_CHAT_THROTTLE_AUTH_PER_MINUTE=60
AI_SUPPORT_THROTTLE_PER_MINUTE=5

# CAPTCHA — two independent systems:
#
# 1) reCAPTCHA v3 (invisible) — protects login + register forms.
#    Set both keys to enable. Leave blank to disable (safe for local dev).
#    Get keys at: https://www.google.com/recaptcha/admin (v3, score-based)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
#
# 2) Chat/support CAPTCHA — protects POST /chat and POST /support-requests.
#    Driver: turnstile (Cloudflare) | recaptcha (uses keys above)
AI_CAPTCHA_DRIVER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# When false, logged-in users skip chat CAPTCHA (guests still need it when keys are set)
AI_CHAT_CAPTCHA_FOR_AUTH=false
