# Copy to .env and adjust (never commit .env)

# MySQL
BAG_DB_HOST=localhost
BAG_DB_USER=root
BAG_DB_PASS=
BAG_DB_NAME=bag_biz

# Docker Compose: set host to the mysql service name and match MYSQL_* in docker-compose.yml
# BAG_DB_HOST=mysql
# BAG_DB_USER=bag
# BAG_DB_PASS=bag
# BAG_DB_NAME=bag_biz

# Admin login username (must match a row in users.username)
BAG_ADMIN_USER=admin

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Laravel public URL (default Docker: nginx on APP_PORT, usually 8080). Set in docker-compose / env so laravel/.env APP_URL matches for Stripe redirects.
# LARAVEL_APP_URL=http://localhost:8080

# Separate MySQL database for Laravel migrations (create manually if your MySQL volume predates docker/mysql/02-create-laravel-db.sql).
# LARAVEL_DB_DATABASE=laravel
